# Clé secrète pour chiffrement des tokens API en base de données
# IMPORTANT: Changez cette valeur avant de déployer !
SECRET_KEY=amtu-please-change-this-secret-key-32chars

# Chemin vers votre dossier de musique (monté en lecture seule dans le container)
# Exemple Linux/Mac: /home/user/Music ou /Volumes/NAS/Music
# Exemple Windows:   C:/Users/User/Music
MUSIC_DIR=/home/user/Music

# Domaine exposé via Traefik (doit pointer vers ce serveur dans Cloudflare)
DOMAIN=amtu.humanbrorecords.club

# URL publique de l'application (utilisée dans les emails)
APP_URL=https://amtu.humanbrorecords.club

# Compte administrateur initial (créé au premier démarrage si aucun user n'existe)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=amtu-change-me
ADMIN_EMAIL=admin@exemple.com
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=AMTU
